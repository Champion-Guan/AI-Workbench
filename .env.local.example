# Copy this file to .env.local and fill in one private node source.
# Never commit .env.local: it may contain subscription credentials.

# Preferred on another computer: a private subscription URL.
IMAGE_RELAY_SUBSCRIPTION_URL=

# Or use a local Sub-Store backend and subscription name.
IMAGE_RELAY_SUBSTORE_API_URL=http://127.0.0.1:38324
IMAGE_RELAY_SUBSCRIPTION_NAME=AWS-SS-6

# Optional. If omitted, the app auto-downloads Mihomo for macOS/Linux,
# or discovers proxy-runtime/mihomo and common system locations.
IMAGE_RELAY_MIHOMO_BIN=
IMAGE_RELAY_MIHOMO_VERSION=
IMAGE_RELAY_PROXY_PORT=17890
