{
  "manifest_version": 3,
  "name": "Guan 工作台受管理窗口",
  "version": "1.0.0",
  "minimum_chrome_version": "128",
  "description": "仅管理本机 Guan 工作台窗口，不更换 Chrome 数据目录。",
  "permissions": ["nativeMessaging", "webNavigation"],
  "host_permissions": ["http://127.0.0.1:5174/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "打开 Guan 工作台受管理窗口" }
}
